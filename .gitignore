# ── data & artefacts ──────────────────────────────────────────────────────
# Directory contents are ignored, but the directories themselves are kept via
# .gitkeep. Note the `dir/*` form: a bare `dir/` stops git descending at all,
# which would make the .gitkeep negation below unreachable.
data/checkpoints/*
data/synthetic/*
data/raw/*
data/tiles/*
data/cache/*
data/workspace/*
data/places/*
data/.flet/*
data/*.db
data/.ctk_orbital_dusk.json
!data/**/.gitkeep

# fonts are downloaded, not vendored
assets/fonts/*.ttf
assets/fonts/*.otf

# ── python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/

# ── tooling caches ────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── editors / os ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── secrets ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
